\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Width confound across three architecturally distinct pools. RankMe correlates strongly with $d$ (large positive $\ensuremath  {\rho _{\mathrm  {Sp}}}\xspace  $) yet $d$ itself does not predict quality (near-zero or negative $\ensuremath  {\rho _{\mathrm  {Sp}}}\xspace  (d, \mathrm  {lp\_acc})$), confirming that $d$ is a confound rather than a signal.\relax }}{4}{table.caption.4}\protected@file@percent }
\newlabel{tab:pool_diagnosis}{{2}{4}{Width confound across three architecturally distinct pools. RankMe correlates strongly with $d$ (large positive $\rhoSp $) yet $d$ itself does not predict quality (near-zero or negative $\rhoSp (d, \mathrm {lp\_acc})$), confirming that $d$ is a confound rather than a signal.\relax }{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces VTAB per-task width confound. Flat-RankMe regret $+0.083$ (mean), suboptimal on all $8/8$ tasks; $\ensuremath  {\rho _{\mathrm  {Sp}}}\xspace  (\mathrm  {RankMe},d)$ is large and positive on every task.\relax }}{4}{table.caption.5}\protected@file@percent }
\newlabel{tab:vtab_pertask}{{3}{4}{VTAB per-task width confound. Flat-RankMe regret $+0.083$ (mean), suboptimal on all $8/8$ tasks; $\rhoSp (\mathrm {RankMe},d)$ is large and positive on every task.\relax }{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Per-task breakdown of Flat-RankMe and Flat-\ensuremath  {\mathrm  {SSR}^{\ddagger }}\xspace  \ on MV pool's multi-variant subset. RankMe selects \texttt  {vgg16} on every task; \ensuremath  {\mathrm  {SSR}^{\ddagger }}\xspace  \ recovers task-appropriate architectures.\relax }}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:main_pertask}{{4}{5}{Per-task breakdown of Flat-RankMe and Flat-\SSRdag \ on MV pool's multi-variant subset. RankMe selects \texttt {vgg16} on every task; \SSRdag \ recovers task-appropriate architectures.\relax }{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces MV pool SOTA flat comparison ($132$v$\times 5$t). Columns report per-task mean regret with and without the three VGG variants in the pool. Feature-spectrum scores (RankMe, LogME, H-score) all select \texttt  {vgg16} when present and degrade similarly; class-distribution scores (LEEP, NCTI) and the proposed \ensuremath  {\mathrm  {SSR}^{\ddagger }}\xspace  \ are robust.\relax }}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:sota_flat}{{5}{5}{MV pool SOTA flat comparison ($132$v$\times 5$t). Columns report per-task mean regret with and without the three VGG variants in the pool. Feature-spectrum scores (RankMe, LogME, H-score) all select \texttt {vgg16} when present and degrade similarly; class-distribution scores (LEEP, NCTI) and the proposed \SSRdag \ are robust.\relax }{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Sensitivity of flat strategies to the presence of VGG-class features ($d{=}4096$) in MV pool. Columns report mean LP across the $5$ tasks. RankMe and the trace-spectrum label-based scores are dominated by VGG when present; \ensuremath  {\mathrm  {SSR}^{\ddagger }}\xspace  , DiSCO, and class-distribution scores (LEEP, NCTI) are robust.\relax }}{5}{table.caption.8}\protected@file@percent }
\newlabel{tab:vgg_sensitivity}{{6}{5}{Sensitivity of flat strategies to the presence of VGG-class features ($d{=}4096$) in MV pool. Columns report mean LP across the $5$ tasks. RankMe and the trace-spectrum label-based scores are dominated by VGG when present; \SSRdag , DiSCO, and class-distribution scores (LEEP, NCTI) are robust.\relax }{table.caption.8}{}}
